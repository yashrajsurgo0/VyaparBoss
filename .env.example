# Copy to .env and fill in. Never commit .env.
PORT=5173

# Claude (Anthropic API) — enables AI parsing of buyer messages and supplier reply drafts.
# Get a key at https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Where the server stores suppliers, RFQs and orders
DATA_FILE=./data/db.json

# WhatsApp Cloud API (Meta) — see docs/WHATSAPP_SETUP.md
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=pick-any-long-random-string
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0
