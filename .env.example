# Copy to .env and fill in. Never commit .env.
PORT=5173

# AI for reading buyer messages and drafting supplier replies. Set ONE of these.
# If both are set, Gemini is used.
# Google Gemini: key from https://aistudio.google.com → Get API key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Used when the main model is overloaded (503). Set empty to disable.
GEMINI_FALLBACK_MODEL=gemini-3.7-flash
# Anthropic Claude: key from https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Where the server stores suppliers, RFQs and orders
DATA_FILE=./data/db.json

# WhatsApp Cloud API (Meta) — see docs/WHATSAPP_SETUP.md
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=pick-any-long-random-string
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0

# Ops tools (Sign-ups, Outreach, supplier quote links). Long random string; your team types it once per browser session.
ADMIN_KEY=
# Public address used in emails and quote links
PUBLIC_URL=https://vyaparboss.onrender.com
# Static copies allowed to send sign-ups and supplier quotes to this server (comma-separated)
ALLOWED_ORIGINS=https://yashrajsurgo0.github.io

# Outreach email — see docs/OUTREACH.md. Nothing is sent until these are set AND you press Send.
EMAIL_PROVIDER=brevo
EMAIL_API_KEY=
OUTREACH_FROM_EMAIL=
OUTREACH_FROM_NAME=VyaparBoss
OUTREACH_REPLY_TO=
OUTREACH_DAILY_CAP=30

# Sign-in. Email + password always works. Each of these turns on one more button. See docs/SIGN_IN_SETUP.md.
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=
APPLE_REDIRECT_URI=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
